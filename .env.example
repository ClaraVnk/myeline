# ===== IMAGE VERSION =====
# Tag de l'image Myeline à tirer depuis le registry public GHCR
# (ghcr.io/claravnk/veille-bibliographique). Doit matcher la version de la
# stack (compose + scripts) que vous voulez faire tourner. Mettez à jour ici
# pour upgrader, puis `podman-compose pull`.
MYELINE_VERSION=v2.0.21

# ===== CONFIGURATION FLASK =====
FLASK_ENV=production
FLASK_DEBUG=false
TESTING=false

# ===== SÉCURITÉ =====
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
SECURITY_PASSWORD_SALT=your-security-salt-here
WTF_CSRF_ENABLED=true
WTF_CSRF_TIME_LIMIT=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# ===== BASE DE DONNÉES =====
# Format: mysql+pymysql://user:password@host:port/database_name
DATABASE_URL=mysql+pymysql://myeline_user:CHANGE_ME_DB_PASSWORD@mariadb:3306/myeline
SQLALCHEMY_DATABASE_URI=mysql+pymysql://myeline_user:CHANGE_ME_DB_PASSWORD@mariadb:3306/myeline
SQLALCHEMY_ECHO=false

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=myeline
DB_USER=myeline_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# MariaDB (Podman Compose) — l'image officielle MariaDB n'initialise
# la DB et l'utilisateur applicatif au premier boot QUE si MYSQL_DATABASE
# et MYSQL_USER sont définis. Doivent matcher DB_NAME et DB_USER
# ci-dessus, sinon l'app ne pourra pas se connecter à une instance
# fraîchement créée.
MYSQL_DATABASE=myeline
MYSQL_USER=myeline_user
# Generate strong values (e.g. `openssl rand -base64 24`) — these placeholders
# are intentionally non-functional so a copied .env can't ship weak defaults.
MYSQL_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ===== PODMAN COMPOSE =====
COMPOSE_PROJECT_NAME=myeline

# ===== FICHIERS & UPLOADS =====
MAX_CONTENT_LENGTH=104857600
UPLOAD_FOLDER=uploads

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_TO_STDOUT=false

# ===== RATE LIMITING =====
RATELIMIT_DEFAULT=200/hour
RATELIMIT_STORAGE_URL=redis://redis:6379/1
DISABLE_RATE_LIMITING=false

# Nombre de proxies trustés entre Internet et Gunicorn (audit round 5 A4-H3).
# ProxyFix lit le N-ième X-Forwarded-For en partant de la fin. Si la chaîne
# est Internet → Nginx → Gunicorn, c'est 1. Mal calibré = tous
# les clients d'un proxy donné se collapsent sur la même IP côté rate-limit,
# rendant brute-force / scanning indétectables sur /login, /register,
# /forgot-password. Clampé à [0, 10].
PROXY_HOPS=1

# ===== OBSERVABILITÉ =====
# Bearer requis pour /metrics + détail complet sur /health (round 5 A4-H1/H2).
# Si vide, l'accès retombe automatiquement sur la whitelist IP loopback +
# RFC1918 — convient à un Prometheus interne. À setter dès qu'un scraper
# tape depuis l'extérieur du LAN.
OBSERVABILITY_API_KEY=

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0
FLASK_LIMITER_STORAGE_URI=redis://redis:6379

# ===== EMAIL (Brevo) =====
BREVO_API_KEY=xkeysib-XXXXXXXXXXXXXXXXXXXXXXXX
MAIL_DEFAULT_SENDER=hello@myeline.io
MAIL_SENDER_NAME=myeline.io
# Kill-switches (precedence: dry-run > dummy-key > FLASK_ENV/MAIL_FORCE_SEND).
#  - MAIL_DRY_RUN=true       always logs instead of sending, regardless of
#                            FLASK_ENV. Use on dev boxes that run with
#                            FLASK_ENV=production for prod-like tests.
#  - MAIL_FORCE_SEND=true    re-enables real delivery when FLASK_ENV != production
#                            (staging that genuinely needs to send).
MAIL_DRY_RUN=false
MAIL_FORCE_SEND=false

# ===== GOOGLE reCAPTCHA v3 =====
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
DISABLE_RECAPTCHA=false

# ===== CHIFFREMENT =====
#
# CLOUD_TOKEN_KEY = clé maître de chiffrement applicatif (Fernet, dérivée via
# PBKDF2-SHA256, 260k itérations). Utilisée pour chiffrer EN BASE :
#   - Tokens OAuth des connexions cloud (Google Drive, OneDrive, Dropbox, kDrive, S3)
#   - Clés API IA per-org (org.ai_api_key_enc)
#   - Secrets TOTP (users.totp_secret) — depuis migration 0014
#   - Historique de requêtes (query_history.query / answer_excerpt)
#   - Recherches sauvegardées (saved_queries.name / query)
#   - Mots-clés d'alertes de veille (watch_alerts.keyword)
#   - Feedback RAG (rag_feedbacks.query / answer_excerpt / comment)
#
# ⚠️ PERTE = données chiffrées illisibles définitivement. Backup obligatoire
# hors du repo (vault, sops, podman secret, YubiKey, enveloppe scellée).
# ⚠️ ROTATION = via la CLI `flask rotate-cloud-token-key --old <ancienne> --new <nouvelle>`
# (re-chiffre toutes les colonnes en place avant de basculer la clé dans .env).
#
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CLOUD_TOKEN_KEY=

# SESSION_ENCRYPTION_KEY = chiffrement des données de session côté serveur
# (Flask-Session si activé). Optionnel, peut rester vide si tu utilises les
# cookies signés Flask par défaut.
SESSION_ENCRYPTION_KEY=

# FILE_ENCRYPTION_KEY = clé Fernet pour le chiffrement des uploads disque
# (uploads/<user>/...). Pas encore activé en production. Quand on l'activera,
# même règle de backup que CLOUD_TOKEN_KEY (perte = fichiers illisibles).
# Générer une clé Fernet :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# ===== URLS PUBLIQUES =====
# URL publique de cette instance (utilisée pour construire les liens absolus
# dans les emails transactionnels et les digests envoyés par cron — qui n'ont
# pas de request context Flask). En self-host, mettez l'URL derrière laquelle
# votre reverse proxy TLS expose l'app. Exemples :
#   - Local :     http://localhost:5000
#   - On-premise : https://myeline.client-acme.local
EXTERNAL_URL=http://localhost:5000

# URL OAuth — doit correspondre exactement au domaine enregistré dans chaque
# console développeur OAuth (souvent identique à EXTERNAL_URL).
OAUTH_REDIRECT_BASE_URL=http://localhost:5000

# ===== OAUTH — CONNEXION SOCIALE =====
# Google Login (console.cloud.google.com — OAuth 2.0 client ID de type "Web application")
# Authorized redirect URI : https://myeline.io/auth/social/google/callback
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

# Microsoft Login (portal.azure.com — Enregistrement d'application)
# Authorized redirect URI : https://myeline.io/auth/social/microsoft/callback
MICROSOFT_LOGIN_CLIENT_ID=
MICROSOFT_LOGIN_CLIENT_SECRET=

# Apple Login (developer.apple.com — Sign in with Apple)
# Authorized redirect URI : https://myeline.io/auth/social/apple/callback
APPLE_LOGIN_CLIENT_ID=
APPLE_LOGIN_PRIVATE_KEY=
APPLE_LOGIN_KEY_ID=
APPLE_LOGIN_TEAM_ID=

# ===== CLOUD STORAGE =====
# Google Drive — compte de service (pas d'OAuth utilisateur, pas de CASA requis)
# 1. Créer un compte de service sur console.cloud.google.com/iam-admin/serviceaccounts
# 2. Télécharger la clé JSON et coller son contenu ci-dessous (sur une seule ligne)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# OneDrive (peut partager les mêmes credentials que Microsoft Login)
# Authorized redirect URI : https://myeline.io/user/cloud/onedrive/callback
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# Dropbox (dropbox.com/developers)
# Authorized redirect URI : https://myeline.io/user/cloud/dropbox/callback
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# kDrive Infomaniak (developer.infomaniak.com)
# Authorized redirect URI : https://myeline.io/user/cloud/kdrive/callback
KDRIVE_CLIENT_ID=
KDRIVE_CLIENT_SECRET=

# ===== IA / RAG =====
# Self-host LLM via Ollama (recommandé en self-host). Le service `ollama`
# du compose tourne en local et sert à la fois l'embedding et la synthèse,
# sans dépendance à une API externe. L'URL ci-dessous est l'adresse interne
# du conteneur Ollama (laisser tel quel dans le compose fourni).
OLLAMA_URL=http://ollama:11434
# Modèle d'embedding local (utilisé quand EMBED_PROVIDER=ollama)
OLLAMA_EMBED_MODEL=bge-m3
# Modèle LLM Ollama servi en local pour la synthèse. Ex : mistral-nemo, llama3.1.
# C'est l'option 100 % self-host (aucun appel sortant).
OLLAMA_LLM_MODEL=mistral-nemo

# Embedding provider — "ollama" (local, self-host) ou "mistral" (API Mistral).
EMBED_PROVIDER=ollama
MISTRAL_EMBED_MODEL=mistral-embed

# Mistral API (OPTIONNEL) — clé plateforme pour la synthèse/embedding via
# l'API Mistral (français, hébergé UE) au lieu d'Ollama. Laisser vide pour
# rester 100 % local. Synthèse : MISTRAL_LLM_MODEL ; appels auxiliaires
# (HyDE, reranking, variantes de requête) : MISTRAL_AUX_MODEL (small) pour
# limiter le coût.
MISTRAL_API_KEY=
MISTRAL_LLM_MODEL=mistral-medium-latest
MISTRAL_AUX_MODEL=mistral-small-latest

# BYOK (bring-your-own-key) : chaque utilisateur peut enregistrer sa propre
# clé LLM chiffrée (Anthropic Claude / OpenAI / Google Gemini / Mistral) via
# Réglages → Fournisseur IA ; les organisations peuvent définir une clé au
# niveau org. Ordre de résolution dans _chat : clé user → clé org → clé
# Mistral plateforme (si configurée) → Ollama local.

# ===== BACKUP (off-host sync via rclone, optional) =====
# rclone remote name + path. Leave empty to keep backups local-only.
# Configure with `rclone config` on the host (see docs/BACKUP.md).
# Examples:
#   BACKUP_REMOTE=gdrive:myeline-backups
#   BACKUP_REMOTE=s3-paris:myeline-prod-backups
BACKUP_REMOTE=
RCLONE_CONFIG_PATH=

# Test accounts that bypass mandatory 2FA — OAuth review reviewers
# (Google / Microsoft / Dropbox app validation), QA accounts, etc.
# CSV of emails (lower-cased + stripped). NEVER add real users here.
# Leave empty in production.
BYPASS_2FA_EMAILS=
