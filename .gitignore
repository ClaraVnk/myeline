# API keys and secrets (double check)
*secret*
*SECRET*
*token*
*TOKEN*
*api_key*
*API_KEY*
*password*
*PASSWORD*

# Exception for test files
!tests/**/test_*.py
!tests/**/*_test.py

# Re-allow legitimate code files matched by the broad *secret* / *password*
# / *token* / *api_key* globs above. Without this re-include, a migration
# like 0021_user_must_reset_password.py (matches *password*) silently
# never reaches git and CI builds an image with a broken alembic chain
# (which is exactly the bug we hit on the v1.1.0 prod push).
# Same trap for templates: `first_password_reset.html` / `forgot_password.html`
# / `reset_password.html` / `email_reset_password.html` / `new_user_temp_password.html`
# never made it to v1.1.1 and the tenant 500'd on /first-password-reset.
!migrations/versions/*.py
!app/**/*.py
!app/templates/**/*.html
!tests/**/*.py

# Legacy bash scripts (deprecated, use Python versions)
app/cron/legacy_bash/*.sh